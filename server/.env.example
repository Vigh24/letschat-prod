PORT=3000
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# AI Configuration (Optional: toggle between 'gemini' and 'ollama')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

# Ollama API settings (optional, used when AI_PROVIDER=ollama)
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# Frontend URL (for CSAT survey link)
FRONTEND_URL=http://localhost:5173

# Twilio Voice settings (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid
TWILIO_CALLER_ID=your_twilio_caller_id
